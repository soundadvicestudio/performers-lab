{
  "version": 2,
  "buildCommand": "echo 'No build step'",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "www.performers-lab.com" }],
      "destination": "https://performers-lab.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/app/(.*)", "dest": "/app/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
